<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MC10.App</RootNamespace>
    <AssemblyName>MC10.App</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Copy a firmware dump placed in the project folder next to the executable. Never committed (see .gitignore). -->
  <ItemGroup>
    <None Include="..\..\symbols\mc10.*" Link="symbols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\symbols\user.sym" Link="symbols\user.sym" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\symbols\user.sym')" />
    <None Include="..\..\basic\samples\*.bas" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="*.bin;*.rom;*.hex;*.ihx;*.s19" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MC10.Core\MC10.Core.csproj" />
  </ItemGroup>

</Project>
